# Copy to server/.env and fill in. Never commit the real .env file.

# Full MongoDB connection string, including username and password.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Long random strings, different from each other. For example: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Front-end origins allowed to call the API with cookies (comma-separated).
CLIENT_ORIGINS=http://localhost:3000

# Behind a load balancer or proxy (most hosts), the number of proxies in front
# of the API, usually 1, so login rate limits see real client addresses.
TRUST_PROXY=

# Set to "production" when deployed over HTTPS (enables Secure, SameSite=None cookies).
NODE_ENV=development
PORT=5000

# Optional: Google Geocoding API key used to geocode addresses for distance search.
# Restrict it to the Geocoding API. Without it, distance filters have no effect.
GOOGLE_MAPS_API_KEY=

# Optional: SMTP server for email alerts (claims, pickups, new food nearby, messages).
# Without it, alerts appear in the app only. The first CLIENT_ORIGINS entry is used for links.
SMTP_URL=
EMAIL_FROM=Ladle <no-reply@example.com>

# Accounts (by email) that can use the admin console to verify food banks.
ADMIN_EMAILS=
# Set to "true" to let only verified food banks claim postings.
REQUIRE_VERIFIED_TO_CLAIM=false

# Optional: web push notifications for the installed app. Generate with `npm run vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
